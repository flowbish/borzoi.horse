.walk {
  /* walk translation for node body (26) */
  .node.node-26 {
    animation: walk-0 0.9583333s infinite linear;
  }
  /* walk rotation for node back_right_leg (5) */
  .node.node-5 {
    animation: walk-1 0.9583333s infinite linear;
  }
  /* walk rotation for node back_left_leg (7) */
  .node.node-7 {
    animation: walk-2 0.9583333s infinite linear;
  }
  /* walk rotation for node front_right_leg (9) */
  .node.node-9 {
    animation: walk-3 0.9583333s infinite linear;
  }
  /* walk rotation for node front_left_leg (11) */
  .node.node-11 {
    animation: walk-4 0.9583333s infinite linear;
  }
  /* walk rotation for node neck (20) */
  .node.node-20 {
    animation: walk-5 0.9583333s infinite linear;
  }
  /* walk rotation for node right_ear (16) */
  .node.node-16 {
    animation: walk-6 0.9583333s infinite linear;
  }
  /* walk rotation for node left_ear (18) */
  .node.node-18 {
    animation: walk-7 0.9583333s infinite linear;
  }
  /* walk rotation for node tail (25) */
  .node.node-25 {
    animation: walk-8 0.9583333s infinite linear;
  }
}
