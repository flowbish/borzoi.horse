.drive {
  /* drive translation for node carriage (48) */
  .node.node-48 {
    animation: drive-0 1s infinite linear;
  }
  /* drive rotation for node mast (55) */
  .node.node-55 {
    animation: drive-1 1s infinite linear;
  }
  /* drive rotation for node wheelFrontR (9) */
  .node.node-9 {
    animation: drive-2 1s infinite linear;
  }
  /* drive rotation for node wheelRearR (15) */
  .node.node-15 {
    animation: drive-3 1s infinite linear;
  }
  /* drive rotation for node wheelFrontL (24) */
  .node.node-24 {
    animation: drive-4 1s infinite linear;
  }
  /* drive rotation for node wheelRearL (30) */
  .node.node-30 {
    animation: drive-5 1s infinite linear;
  }
  /* drive rotation for node chassis (76) */
  .node.node-76 {
    animation: drive-6 1s infinite linear;
  }
  /* drive translation for node chassis (76) */
  .node.node-76 {
    animation: drive-7 1s infinite linear;
  }
  /* drive rotation for node beacon (2) */
  .node.node-2 {
    animation: drive-8 1s infinite linear;
  }
  /* drive translation for node pallet (41) */
  .node.node-41 {
    animation: drive-9 1s infinite linear;
  }
}
