.drop_load {
  /* drop_load translation for node carriage (48) */
  .node.node-48 {
    animation: drop_load-0 2.4s infinite linear;
  }
  /* drop_load rotation for node mast (55) */
  .node.node-55 {
    animation: drop_load-1 2.4s infinite linear;
  }
  /* drop_load rotation for node beacon (2) */
  .node.node-2 {
    animation: drop_load-2 2.4s infinite linear;
  }
  /* drop_load translation for node pallet (41) */
  .node.node-41 {
    animation: drop_load-3 2.4s infinite linear;
  }
}
